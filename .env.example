# Configuración de Entorno de E-Com Agent Backend
# Duplicar este archivo como '.env' y completar con tus credenciales

# ─────────────────────────────────────────────────────────────────────────────
# 1A. Google AI Studio (Gemini) - Clave Principal
#     Obtener en: https://aistudio.google.com/apikey
# ─────────────────────────────────────────────────────────────────────────────
API_KEY=AIzaSy...
MODEL=gemini-3.6-flash

# ─────────────────────────────────────────────────────────────────────────────
# 1B. Google AI Studio (Gemini) - Clave Secundaria (misma cuota, distinta key)
#     Opcional. Si se configura, se usa como segundo intento cuando API_KEY
#     agota su cuota. Permite duplicar el throughput gratuito de Gemini.
# ─────────────────────────────────────────────────────────────────────────────
API_KEY_2=AIzaSy...

# ─────────────────────────────────────────────────────────────────────────────
# 2. Groq Cloud (Gratuito en console.groq.com)
#    Tercera capa de redundancia con modelos especializados por tarea:
#    - GROQ_TEXT_FAST_MODEL    → fraude/clasificación rápida (Qwen 3.6 27B)
#    - GROQ_TEXT_REASONING_MODEL → RAG/razonamiento profundo (GPT-OSS 120B)
#    - GROQ_VISION_MODEL       → contingencia textual si Gemini no responde
# ─────────────────────────────────────────────────────────────────────────────
GROQ_API_KEY=gsk_...
GROQ_VISION_MODEL=openai/gpt-oss-20b
GROQ_TEXT_FAST_MODEL=qwen/qwen3.6-27b
GROQ_TEXT_REASONING_MODEL=openai/gpt-oss-120b

# ─────────────────────────────────────────────────────────────────────────────
# 3. Base de Datos
#    SQLite local por defecto. En Vercel usa /tmp (automático).
#    Para producción con persistencia real, usar PostgreSQL (Neon, Supabase, etc.)
# ─────────────────────────────────────────────────────────────────────────────
# DATABASE_URL=sqlite+aiosqlite:///./ecom_agent.db
# DATABASE_URL=postgresql+asyncpg://usuario:password@host:5432/dbname?ssl=require

# ─────────────────────────────────────────────────────────────────────────────
# 4. Entorno de ejecución
# ─────────────────────────────────────────────────────────────────────────────
ENVIRONMENT=development
PROJECT_NAME="E-Com Agent API"
