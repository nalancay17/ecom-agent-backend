# Configuración de Entorno de E-Com Agent Backend
# Duplicar este archivo como '.env' y completar con tus credenciales

# 1. Google AI Studio (Gemini) - Requerido para Visión Multimodal Principal
API_KEY=AIzaSy...
MODEL=gemini-3.6-flash

# 2. Groq Cloud (Gratuito en console.groq.com) - Para Redundancia y Agentes Especializados Livianos
GROQ_API_KEY=gsk_...
GROQ_VISION_MODEL=llama-3.2-11b-vision-preview
GROQ_TEXT_FAST_MODEL=llama-3.1-8b-instant
GROQ_TEXT_REASONING_MODEL=llama-3.3-70b-versatile

# 3. Base de Datos (SQLite local por defecto; en Vercel usa /tmp; o PostgreSQL Neon en la nube)
# DATABASE_URL=sqlite+aiosqlite:///./ecom_agent.db
# DATABASE_URL=postgresql+asyncpg://usuario:password@host:5432/dbname?ssl=require

# 4. Entorno de ejecución
ENVIRONMENT=development
PROJECT_NAME="E-Com Agent API"
