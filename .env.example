# Configuración de Entorno de E-Com Agent Backend
# Duplicar este archivo como '.env' y completar con tus credenciales

# Clave de API de Google Gemini (requerida para visión y razonamiento agéntico)
API_KEY=AIzaSy...

# Modelo de Google Gemini a utilizar
MODEL=gemini-3.6-flash

# Base de Datos (Por defecto SQLite local; para PostgreSQL cloud usar formato postgresql+asyncpg://...)
# DATABASE_URL=sqlite+aiosqlite:///./ecom_agent.db
# DATABASE_URL=postgresql+asyncpg://usuario:password@host:5432/dbname?ssl=require

# Entorno de ejecución (development / production)
ENVIRONMENT=development
PROJECT_NAME="E-Com Agent API"
